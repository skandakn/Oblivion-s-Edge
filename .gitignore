# =========================================================================
# Unity Official .gitignore Template for Oblivion's Edge (Unity 2D Project)
# =========================================================================

# Unity-generated files and folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store packages
[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / VS Code / JetBrains Rider project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler and crash traces
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Unity cache
.vs/
.idea/
.vscode/

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini

# Crashlytics
crashlytics-build.properties
